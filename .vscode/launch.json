{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Play game",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:GODOT4}",
            "args": ["--path", "${workspaceFolder}"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "Open in Godot editor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:GODOT4}",
            "args": ["--path", "${workspaceFolder}", "--editor"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "Attach to running Godot",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
